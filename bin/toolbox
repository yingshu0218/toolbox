#!/usr/bin/env bash
# Toolbox 启动命令 — 后台启动服务并打开浏览器
# 子命令: stop (停止) | status (状态) | 无参数 (启动)
# 后台运行, 关闭终端不影响
set -u

PY="${TOOLBOX_PYTHON:-python3}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${TOOLBOX_ROOT:-$SCRIPT_DIR/..}"
PORT="${TOOLBOX_PORT:-9053}"
PID_FILE="$ROOT/toolbox.pid"
LOG_FILE="/tmp/toolbox.log"

if [ "${1:-}" = "stop" ]; then
  if [ -f "$PID_FILE" ] && kill "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "Toolbox 已停止"
  else
    echo "Toolbox 未运行"
  fi
  rm -f "$PID_FILE"; exit 0
fi

if [ "${1:-}" = "status" ]; then
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "Toolbox 运行中 (PID: $(cat "$PID_FILE")) → http://localhost:${PORT}"
  else
    echo "Toolbox 未运行"
  fi
  exit 0
fi

if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  echo "Toolbox 已在运行 → http://localhost:${PORT}"
  open "http://localhost:${PORT}/" 2>/dev/null; exit 0
fi

export TOOLBOX_PORT="$PORT"
echo "🏠 Toolbox 启动中 → http://localhost:${PORT}"
nohup "$PY" "$ROOT/home/server.py" >"$LOG_FILE" 2>&1 &
echo $! > "$PID_FILE"
echo "   PID: $(cat "$PID_FILE") | 日志: $LOG_FILE"
echo "   停止: toolbox stop | 状态: toolbox status"

for i in $(seq 1 60); do
  if curl -sf "http://127.0.0.1:${PORT}/" >/dev/null 2>&1; then
    open "http://localhost:${PORT}/" 2>/dev/null || xdg-open "http://localhost:${PORT}/" 2>/dev/null
    break
  fi
  sleep 0.5
done
